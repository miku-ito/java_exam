--問題7
SELECT * FROM genders;
SELECT * FROM populations;
SELECT * FROM prefectures;

WITH gender_code AS(
SELECT gender_code,
CASE gender_code
when 'm' THEN '男'
when 'f' THEN '女'
ELSE 'other'
end
FROM populations
)
SELECT pr.name prefecture, gender_code gender, po.population 
FROM prefectures pr 
INNER JOIN populations po 
ON pr.region_code = po.prefecture_code
WHERE pr.region_code = 80;

